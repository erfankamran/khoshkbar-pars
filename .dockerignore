# ============================================================
# فروشگاه پارس — فایل‌هایی که به build context ایمیج ارسال نمی‌شوند
# (حجم کمتر + جلوگیری از ورود وابستگی‌ها و خروجی‌های بیلد محلی)
# ============================================================

# وابستگی‌ها و خروجی بیلد — داخل کانتینر از نو نصب و بیلد می‌شود
# (مهم: باینری‌های محلی sharp/prisma مخصوص لینوکس glibc هستند و
#  روی Alpine خراب می‌شوند — باید داخل کانتینر نصب شوند)
node_modules
.next

# گیت و فایل‌های محیطی
.git
.gitignore
.env*

# فایل قفل بون — داکر از package-lock.json (npm) استفاده می‌کند
bun.lock

# پوشه‌های مخصوص محیط سندباکس/توسعه محلی
upload
download
skills
mini-services
.zscripts
tests
scripts
tool-results

# لاگ‌ها
*.log

# فایل‌های خودِ داکر (داخل ایمیج لازم نیستند)
Dockerfile
docker-compose.yml
.dockerignore
DOCKER.md

# ریورس‌پراکسی پلتفرم پیش‌نمایش — ربطی به ایمیج ندارد
Caddyfile

# ژورنال‌های زنده SQLite (خود دیتابیس db/custom.db عمداً همراه ایمیج می‌رود
# تا اولین اجرا با داده‌های کامل فروشگاه بالا بیاید)
db/*.db-journal
db/*.db-wal
db/*.db-shm

# فایل‌های موقت تایپ‌اسکریپت
*.tsbuildinfo
next-env.d.ts
