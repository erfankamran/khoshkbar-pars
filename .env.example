# ═══════════════════════════════════════════════════════════════
#  نمونهٔ متغیرهای محیطی فروشگاه پارس — مستندات
#  فایل واقعی: .env (کامیت‌شده — تک‌منبع حقیقت بیلد پلتفرم)
#  کپی با: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── وضعیت توسعه/دمو (کلید اصلی) ─────────────────────────────────
# true  → باکس طلایی کد مادر در لاگین + علت فنی خطاها در پیام‌ها
# false → حالت تولید (پیشنهاد برای انتشار عمومی)
NEXT_PUBLIC_DEV_MODE=false

# کد مادر OTP — فقط وقتی NEXT_PUBLIC_DEV_MODE=true اثر دارد
OTP_MASTER_CODE=123456
NEXT_PUBLIC_OTP_MASTER_CODE=123456
# نمایش devCode در پاسخ OTP (escape-hatch تست روی بیلد تولیدی)
OTP_DEV_CODE_EXPOSE=

# ── دیتابیس (Prisma / SQLite) ────────────────────────────────────
DATABASE_URL=file:./db/custom.db

# ── امنیت ────────────────────────────────────────────────────────
# openssl rand -hex 32
AUTH_SECRET=<۶۴-کاراکتر تصادفی>

# ── سایت ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://<دامنهٔ شما>
MEDIA_STORAGE_DIR=<مسیر مطلق پوشهٔ storage/media>
PRISMA_LOG_QUERIES=0

# ── لینک‌های بیرونی فروشگاه (فوتر — درخواست کاربر) ──────────────
# خالی یا نامعتبر = نمایش داده نمی‌شود؛ فقط http(s) معتبر است.
# در موتور سرور خوانده می‌شود — تغییرش فقط ری‌استارت می‌خواهد، نه rebuild.
# اینماد: معمولاً لینک نشان با id و Code (لینک + کد در یک URL):
SHOP_ENAMAD_URL=
# نشان ملی ساماندهی:
SHOP_SAMANDAHI_URL=
# صفحهٔ فروشگاه در ترب (مثل https://torob.com/shop/…):
SHOP_TOROB_URL=
# صفحهٔ فروشگاه در ایمالز (مثل https://emalls.ir/…):
SHOP_EMALLS_URL=

# ── سرویس پیامک از env (ملی‌پیامک — درخواست کاربر) ───────────────
# هر چهار مقدار باید کامل باشد تا بر تنظیمات پنل ادمین مقدم شود؛
# در غیر این‌صورت پیکربندی پنل (جدول Setting) به‌کار می‌رود.
SMS_PROVIDER=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=

# ── وب‌پوش نوتیفیکیشن (Web Push) ─────────────────────────────────
VAPID_PUBLIC_KEY=<کلید عمومی>
VAPID_PRIVATE_KEY=<کلید خصوصی>
VAPID_SUBJECT=mailto:support@pars-shop.ir
